<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="ur5e_isaac">
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <link name="world"/>
  <xacro:ur_robot
      name="ur5e" tf_prefix="" parent="world"
      generate_ros2_control_tag="false"
      joint_limits_parameters_file="$(find ur_description)/config/ur5e/joint_limits.yaml"
      kinematics_parameters_file="$(find ur_description)/config/ur5e/default_kinematics.yaml"
      physical_parameters_file="$(find ur_description)/config/ur5e/physical_parameters.yaml"
      visual_parameters_file="$(find ur_description)/config/ur5e/visual_parameters.yaml">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ur_robot>

  <ros2_control name="ur5e_isaac_system" type="system">
    <hardware>
      <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
      <param name="joint_commands_topic">/isaac_joint_commands</param>
      <param name="joint_states_topic">/isaac_joint_states</param>
    </hardware>
    <xacro:macro name="jiface" params="jname">
      <joint name="${jname}">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>
    <xacro:jiface jname="shoulder_pan_joint"/>
    <xacro:jiface jname="shoulder_lift_joint"/>
    <xacro:jiface jname="elbow_joint"/>
    <xacro:jiface jname="wrist_1_joint"/>
    <xacro:jiface jname="wrist_2_joint"/>
    <xacro:jiface jname="wrist_3_joint"/>
  </ros2_control>
</robot>
